#!/usr/bin/env bash
# Baseline default preset for this fork. Loaded automatically when no
# TUT_PRESET is set. Switch with `export TUT_PRESET=<name>` (see
# presets/README.md to add your own), or skip presets entirely with
# `export TUT_PRESET=none`.
#
# Every value uses ${VAR:-default}, so an explicit environment variable still wins.

export TUT_TTS="${TUT_TTS:-openai}"
export TUT_VOICE="${TUT_VOICE:-marin}"
export TUT_TTS_INSTRUCTIONS="${TUT_TTS_INSTRUCTIONS:-Clear, friendly, professional narration for a training video. Steady and unhurried.}"
export TUT_RES="${TUT_RES:-1920x1080}"
export TUT_FPS="${TUT_FPS:-25}"
